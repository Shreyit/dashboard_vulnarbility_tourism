# Copy to `.env` in this same directory (the repo root) and fill in.
# Every setting is optional -- the dashboard runs fully without this file.
#
# Settings are read by backend/app/config.py, which uses the `DASHBOARD_`
# prefix, so the environment variable name is NOT plain GROQ_API_KEY.

# PahadiBot's language model. Without it /api/chat still answers -- it says
# it isn't connected and returns the raw grounding context rather than
# inventing one. Get a key at https://console.groq.com/keys
DASHBOARD_GROQ_API_KEY=

# Optional overrides
# DASHBOARD_GROQ_MODEL=llama-3.3-70b-versatile
# DASHBOARD_CORS_ORIGINS=["http://localhost:5173"]
